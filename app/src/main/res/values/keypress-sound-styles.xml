<?xml version="1.0" encoding="utf-8"?>
<!-- Keypress sound styles. Every value but "system" is synthesized by KeySoundSynth. -->
<resources>
    <string name="config_default_keypress_sound_style" translatable="false">system</string>
    <!-- Ranges of the synthesized sound settings (KeySoundSynth), not used by "system" -->
    <integer name="config_min_keypress_sound_pitch">-12</integer> <!-- semitones -->
    <integer name="config_max_keypress_sound_pitch">12</integer>
    <integer name="config_min_keypress_sound_length">50</integer> <!-- percent -->
    <integer name="config_max_keypress_sound_length">200</integer>
    <integer name="config_keypress_sound_length_step">5</integer>
    <integer name="config_min_keypress_sound_tone">-10</integer> <!-- 15% cutoff steps -->
    <integer name="config_max_keypress_sound_tone">10</integer>
    <integer name="config_max_keypress_sound_variation">100</integer> <!-- percent -->
    <integer name="config_keypress_sound_variation_step">5</integer>
    <string-array name="keypress_sound_style_values" translatable="false">
        <item>system</item>
        <item>soft</item>
        <item>click</item>
        <item>typewriter</item>
        <item>mechanical</item>
        <item>bubble</item>
    </string-array>
    <string-array name="keypress_sound_style_names">
        <item>@string/keypress_sound_style_system</item>
        <item>@string/keypress_sound_style_soft</item>
        <item>@string/keypress_sound_style_click</item>
        <item>@string/keypress_sound_style_typewriter</item>
        <item>@string/keypress_sound_style_mechanical</item>
        <item>@string/keypress_sound_style_bubble</item>
    </string-array>
</resources>
